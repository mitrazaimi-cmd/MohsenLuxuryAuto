# ─── Site ────────────────────────────────────────────────────────────────
# The public URL once live, e.g. https://mohsenluxuryauto.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Admin login (/admin) ────────────────────────────────────────────────
# Mohsen's login email (comma-separate to allow more than one).
ADMIN_EMAIL=
# At least 10 characters. Use a long, unique password.
ADMIN_PASSWORD=
# Random secret for signing the login cookie (32+ characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ─── Stage 1: Database (Supabase) ────────────────────────────────────────
# Empty = local mode (data saved in .data/db.json on this computer).
SUPABASE_URL=
# Settings → API → service_role key. Server-only: never expose it in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Stage 2: Calendar (Google Calendar) ─────────────────────────────────
# Empty = only bookings made on the site block times.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The private_key from the service-account JSON, in quotes, with \n line breaks.
GOOGLE_PRIVATE_KEY=
# Usually Mohsen's Gmail address (Calendar settings → Integrate calendar → Calendar ID).
GOOGLE_CALENDAR_ID=

# ─── Stage 3: Email (Resend) ─────────────────────────────────────────────
# Empty = emails are saved as previews in Admin → Emails.
RESEND_API_KEY=
# A sender on your verified domain, e.g. "Mohsen Luxury Auto <mohsen@mohsenluxuryauto.com>"
EMAIL_FROM=
# Where client replies should go (optional), e.g. Mohsen's own inbox.
EMAIL_REPLY_TO=

# ─── Stage 4: Hosting (Vercel) ───────────────────────────────────────────
# Protects the daily reminder and follow-up jobs. Any long random string.
CRON_SECRET=
